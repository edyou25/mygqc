{
  "version": "1.0",
  "description": "TowerOptimize 算法配置文件",
  
  "general": {
    "enableLogging": true,
    "defaultAlgorithm": "astar"
  },
  
  "linear": {
    "description": "线性优化算法参数",
    "ratio": 0.2
  },
  
  "astar": {
    "description": "A* 路径优化算法参数",
    "cellSizeMeters": 15,
    "radiusCells": 25,
    "weightDeviation": 0.5,
    "weightSignal": 12000,
    "maxIterations": 15000,
    "corridor": {
      "baseMeters": 25.0,
      "segmentRatio": 0.18,
      "maxMeters": 80.0,
      "collisionRelaxMultiplier": 3.0
    },
    "anchorMoveRadiusMeters": 20.0,
    "separation": {
      "minMeters": 5.0,
      "safeMeters": 15.0
    },
    "signalModel": {
      "attenuationExponent": 1.2,
      "baseDistanceMeters": 300.0,
      "signalRadiusMeters": 12000.0,
      "strengthMultiplier": 1.0
    }
  },
  
  "rrt": {
    "description": "RRT 随机树优化算法参数",
    "searchRadiusMeters": 500.0,
    "stepMeters": 50.0,
    "maxSamples": 3000,
    "goalBias": 0.2,
    "weightDeviation": 0.01,
    "weightSignal": 25000,
    "minSeparationMeters": 5.0,
    "safeSeparationMeters": 15.0,
    "signalModel": {
      "attenExp": 1.2,
      "baseDistance": 300.0,
      "sigRadiusMeters": 12000.0,
      "strengthMultiplier": 1.0
    }
  },
  
  "astar_new": {
    "description": "A* 新算法 - 自适应步长避障路径规划",
    "stepSizeMeters": 100.0,
    "maxStepSizeMeters": 500.0,
    "minStepSizeMeters": 50.0,
    "searchRadiusMeters": 5000.0,
    "maxWaypoints": 100,
    "weightDeviation": 0.1,
    "weightSignal": 18000,
    "weightCollision": 10000.0,
    "collisionBufferMeters": 150.0,
    "maxIterations": 5000,
    "signalModel": {
      "attenExp": 1.2,
      "baseDistance": 300.0,
      "sigRadiusMeters": 12000.0,
      "strengthMultiplier": 1.0
    }
  },
  
  "collision": {
    "description": "碰撞检测参数",
    "enableCollisionCheck": true,
    "minAltitudeAGL": 5.0,
    "terrainClearance": 2.0,
    "minWaypointTerrainClearanceMeters": 20.0,
    "buildingClearance": 6.0,
    "minWaypointBuildingClearanceMeters": 8.0,
    "buildingSampleSpacingMeters": 25.0,
    "buildingCorridorPaddingMeters": 180.0,
    "terrainAutoRaiseMarginMeters": 0.0,
    "weatherCollisionCheck": true,
    "weatherBufferMeters": 5.0
  },

  "score": {
    "description": "路径评分参数，优先突出信号收益，弱化平滑度和障碍距离的量纲压制",
    "normalizeWeights": true,
    "weights": {
      "signal": 0.80,
      "obstacle": 0.05,
      "building": 0.10,
      "smooth": 0.03,
      "length": 0.02
    },
    "scales": {
      "signal": 1.0,
      "obstacle": 1.0,
      "building": 1.0,
      "smooth": 0.05,
      "length": 1.0
    },
    "metricSampleSpacingMeters": 20.0,
    "obstacleNoDataDistanceMeters": 60.0,
    "signalMinBlend": 0.35,
    "obstacleMinBlend": 0.40,
    "buildingMinBlend": 0.55,
    "hardCollisionPenalty": 6.0,
    "buildingHardCollisionPenalty": 4.0,
    "obstacleRewardCapMeters": 25.0,
    "obstacleMinRefMeters": 12.0,
    "buildingClearanceRefMeters": 20.0,
    "buildingNoDataClearanceMeters": 30.0,
    "lengthRefMeters": 10000.0,
    "smoothMaxTurnDeg": 180.0
  }
}
